PORT=8787
AIAGENT_AUTH_TOKEN=change_this_same_token_as_spring_boot

OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Homestay Marketing AI Agent

# Local AiToEarn source server. Khong dung Docker/khong dung AiToEarn online.
# Chay tu folder aiagent/AiToEarn/project/aitoearn-backend, app aitoearn-server mac dinh dung port 7001.
AITOEARN_SERVER_BASE_URL=http://127.0.0.1:7001/api
AITOEARN_SERVER_API_KEY=optional_local_aitoearn_internal_key
AITOEARN_REQUIRE_PUBLISH=true
