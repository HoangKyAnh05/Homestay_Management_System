{
  "manifest_version": 3,
  "name": "Lá Đỏ Homestay - Form Auto Tester & Validation Suite",
  "version": "1.0.0",
  "description": "Extension tự động điền form và test case validation toàn diện cho Lá Đỏ Homestay (Đặt phòng, Multi-room, Check-in, Auth).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lá Đỏ Form Auto Tester"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.ngrok-free.dev/*",
    "https://*.myvnc.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
