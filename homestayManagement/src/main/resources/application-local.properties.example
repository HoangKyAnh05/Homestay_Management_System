DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_at_least_32_chars

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

APP_PUBLIC_BASE_URL=http://localhost:8080

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

SEPAY_BANK_NAME=Vietcombank
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_ACCOUNT_HOLDER=NGUYEN VAN A
SEPAY_PAYMENT_CODE_PREFIX=HMS
SEPAY_TRANSFER_PREFIX=
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_hmac_secret

AI_CUSTOMER_SERVICE_URL=http://127.0.0.1:8001
AI_INTERNAL_TOKEN=the_same_random_secret_as_openchatbi_env
AI_CUSTOMER_TIMEOUT_SECONDS=60
AI_CUSTOMER_RATE_LIMIT_PER_MINUTE=20
AI_CUSTOMER_SIDECAR_AUTO_START=true
AI_CUSTOMER_SIDECAR_WORKING_DIRECTORY=../openchatbi
AI_CUSTOMER_SIDECAR_ENV_FILE=customer_assistant/.env
AI_CUSTOMER_SIDECAR_UV_COMMAND=uv

MARKETING_AIAGENT_ENABLED=true
MARKETING_AIAGENT_BASE_URL=http://127.0.0.1:8787
MARKETING_AIAGENT_AUTH_TOKEN=change_this_same_token_as_aiagent_env
MARKETING_AIAGENT_GENERATE_PATH=/api/homestay/marketing/generate
MARKETING_AIAGENT_PUBLISH_PATH=/api/homestay/marketing/publish
MARKETING_AIAGENT_TIMEOUT_SECONDS=90
MARKETING_AIAGENT_SIDECAR_AUTO_START=true
MARKETING_AIAGENT_SIDECAR_WORKING_DIRECTORY=../aiagent/homestay-marketing-agent
MARKETING_AIAGENT_SIDECAR_NODE_COMMAND=node

# Legacy direct AiToEarn relay. Keep false when using option B.
MARKETING_AITOEARN_ENABLED=false
MARKETING_AITOEARN_API_BASE_URL=
MARKETING_AITOEARN_API_KEY=
MARKETING_AITOEARN_TIMEOUT_SECONDS=45
