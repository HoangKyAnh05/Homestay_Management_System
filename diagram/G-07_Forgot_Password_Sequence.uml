@startuml
actor Guest
boundary "ForgotPasswordPage" as Page
control "AuthController" as Controller
control "PasswordResetServiceImpl" as Service
entity "AccountRepository" as AccountRepo
entity "OtpTokenRepository" as OtpRepo
database "Database" as Database

autonumber

== Send Password Reset OTP ==
Guest -> Page : Enter Email and submit
activate Page

Page -> Controller : POST /api/auth/forgot-password (ForgotPasswordRequest)
activate Controller

Controller -> Service : sendOtp(request)
activate Service

Service -> AccountRepo : existsByEmail(email)
activate AccountRepo
AccountRepo -> Database : Check if email exists
activate Database
Database --> AccountRepo : Return boolean
deactivate Database
AccountRepo --> Service : Return boolean
deactivate AccountRepo

alt Email Does Not Exist
    Service --> Controller : Return early (void)
    Controller --> Page : Return HTTP 200 OK ("Nếu email tồn tại, mã OTP đã được gửi")
    Page --> Guest : Show notification to check email
else Email Exists
    Service -> OtpRepo : deleteAllByEmail(email)
    activate OtpRepo
    OtpRepo -> Database : Delete old OTP tokens
    activate Database
    Database --> OtpRepo : Acknowledge delete
    deactivate Database
    OtpRepo --> Service : Return void
    deactivate OtpRepo

    Service -> OtpRepo : save(otpToken)
    activate OtpRepo
    OtpRepo -> Database : Save newly generated OTP token
    activate Database
    Database --> OtpRepo : Return saved OtpToken
    deactivate Database
    OtpRepo --> Service : Return OtpToken
    deactivate OtpRepo

    Service -> Service : Send OTP Email via JavaMailSender
    Service --> Controller : Return void
    deactivate Service

    Controller --> Page : Return HTTP 200 OK ("Nếu email tồn tại, mã OTP đã được gửi")
    deactivate Controller

    Page --> Guest : Display OTP input form
end

== Verify Reset OTP ==
Guest -> Page : Enter OTP and submit
activate Page

Page -> Controller : POST /api/auth/verify-otp (VerifyOtpRequest)
activate Controller

Controller -> Service : verifyOtp(request)
activate Service

Service -> OtpRepo : findTopByEmailOrderByExpiresAtDesc(email)
activate OtpRepo
OtpRepo -> Database : Fetch latest OTP token
activate Database
Database --> OtpRepo : Return OtpToken
deactivate Database
OtpRepo --> Service : Return Optional<OtpToken>
deactivate OtpRepo

alt OTP Invalid / Expired / Used
    Service --> Controller : Throw IllegalArgumentException("Ma OTP khong dung hoac da het han")
    Controller --> Page : Return HTTP 400 Bad Request / 401 Unauthorized (Error message)
    Page --> Guest : Display validation error message
else OTP Valid
    Service --> Controller : Return void
    deactivate Service

    Controller --> Page : Return HTTP 200 OK ("Mã OTP hợp lệ")
    deactivate Controller

    Page --> Guest : Display Reset Password Form (New Password input)
end

== Reset Password ==
Guest -> Page : Enter New Password and submit
activate Page

Page -> Controller : POST /api/auth/reset-password (ResetPasswordRequest)
activate Controller

Controller -> Service : resetPassword(request)
activate Service

Service -> OtpRepo : findTopByEmailOrderByExpiresAtDesc(email)
activate OtpRepo
OtpRepo -> Database : Fetch latest OTP token for validation
activate Database
Database --> OtpRepo : Return OtpToken
deactivate Database
OtpRepo --> Service : Return Optional<OtpToken>
deactivate OtpRepo

alt OTP Invalid / Expired / Used
    Service --> Controller : Throw IllegalArgumentException("Ma OTP khong dung hoac da het han")
    Controller --> Page : Return HTTP 400 Bad Request / 401 Unauthorized
    Page --> Guest : Display error message
else OTP Valid
    Service -> AccountRepo : findByEmail(email)
    activate AccountRepo
    AccountRepo -> Database : Query Account
    activate Database
    Database --> AccountRepo : Return Account
    deactivate Database
    AccountRepo --> Service : Return Optional<Account>
    deactivate AccountRepo

    Service -> AccountRepo : save(account)
    activate AccountRepo
    AccountRepo -> Database : Save encoded new password to Account
    activate Database
    Database --> AccountRepo : Return saved Account
    deactivate Database
    AccountRepo --> Service : Return Account
    deactivate AccountRepo

    Service -> OtpRepo : deleteAllByEmail(email)
    activate OtpRepo
    OtpRepo -> Database : Clean up used OTP tokens
    activate Database
    Database --> OtpRepo : Acknowledge delete
    deactivate Database
    OtpRepo --> Service : Return void
    deactivate OtpRepo

    Service --> Controller : Return void
    deactivate Service

    Controller --> Page : Return HTTP 200 OK ("Đặt lại mật khẩu thành công")
    deactivate Controller

    Page --> Guest : Show success message, redirect to Login Page
    deactivate Page
end
@endum
